<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Finalpass.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Finalpass.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Finalpass.App.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    KeyDown="Page_KeyDown"
    PointerMoved="Page_PointerMoved"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewVaultAccelerator_Invoked" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="LockAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="U" Modifiers="Control,Shift" Invoked="CopyUsernameAccelerator_Invoked" />
        <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="CopyPasswordAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MinHeight="52" Padding="12,7"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="4">
                <Button MinWidth="0" Padding="10,7" Click="NewVault_Click" ToolTipService.ToolTip="Create a new vault">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New vault" />
                    </StackPanel>
                </Button>
                <Button MinWidth="0" Padding="10,7" Click="OpenVault_Click" ToolTipService.ToolTip="Open a vault file">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="Open vault" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" MinWidth="0" Padding="10,7" Click="SaveVault_Click" ToolTipService.ToolTip="Save vault">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button x:Name="LockButton" MinWidth="0" Padding="10,7" Click="LockVault_Click" ToolTipService.ToolTip="Lock vault">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72E;" FontSize="14" />
                        <TextBlock Text="Lock" />
                    </StackPanel>
                </Button>
                <Button MinWidth="0" Padding="10,7" ToolTipService.ToolTip="More actions">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="BackupButton" Text="Backup" Click="BackupVault_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ChangePasswordButton" Text="Change master password…" Click="ChangeMasterPassword_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator x:Name="VaultMenuSeparator" />
                            <MenuFlyoutItem Text="Settings…" Click="Settings_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Keyboard shortcuts…" Click="KeyboardShortcuts_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <TextBlock Text="More" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="WelcomePanel" Grid.Row="1">
            <StackPanel MaxWidth="520" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image
                    Width="96"
                    Height="96"
                    Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                    AutomationProperties.Name="Finalpass logo" />
                <TextBlock HorizontalAlignment="Center" Text="Your passwords, kept offline" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Finalpass stores the complete vault in one authenticated, encrypted .fpass file. It never needs a network connection."
                    TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="LastVaultDescription" Visibility="Collapsed"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Name="UnlockLastVaultButton" Content="Unlock last vault" Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}" Click="UnlockLastVault_Click" />
                    <Button x:Name="CreateVaultButton" Content="Create a vault"
                            Style="{StaticResource AccentButtonStyle}" Click="NewVault_Click" />
                    <Button Content="Open vault" Click="OpenVault_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="VaultPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationPaneColumn" Width="230" MinWidth="190" />
                <ColumnDefinition x:Name="NavigationPaneSplitterColumn" Width="7" />
                <ColumnDefinition x:Name="LoginListColumn" Width="340" MinWidth="240" />
                <ColumnDefinition x:Name="LoginListSplitterColumn" Width="7" />
                <ColumnDefinition x:Name="EditorPaneColumn" Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="20" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0" Spacing="18">
                    <TextBlock Text="{x:Bind ViewModel.VaultName, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="AddEntryButton" HorizontalAlignment="Stretch" Click="AddEntry_Click"
                            Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Create a new login">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New login" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="8">
                        <TextBlock Text="FOLDERS" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ListView x:Name="FolderListView" MaxHeight="180" Padding="0"
                                  ItemsSource="{x:Bind ViewModel.Folders}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderListItem">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="6" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NewFolderButton" Width="36" Height="36" MinWidth="0" Padding="0"
                                    Click="NewFolder_Click" ToolTipService.ToolTip="New folder"
                                    AutomationProperties.Name="New folder">
                                <SymbolIcon Symbol="NewFolder" />
                            </Button>
                            <Button x:Name="RenameFolderButton" Grid.Column="1" Width="36" Height="36"
                                    MinWidth="0" Padding="0" Click="RenameFolder_Click"
                                    ToolTipService.ToolTip="Rename folder" AutomationProperties.Name="Rename folder">
                                <SymbolIcon Symbol="Rename" />
                            </Button>
                            <Button x:Name="DeleteFolderButton" Grid.Column="2" Width="36" Height="36"
                                    MinWidth="0" Padding="0" Click="DeleteFolder_Click"
                                    ToolTipService.ToolTip="Delete folder" AutomationProperties.Name="Delete folder">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="FILTER" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox Header="Tag" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Tags}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{x:Bind ViewModel.SelectedTag, Mode=TwoWay}" />
                        <CheckBox Content="Favorites only" IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}" />
                        <CheckBox Content="Search password values"
                                  ToolTipService.ToolTip="Password values are excluded from search by default."
                                  IsChecked="{x:Bind ViewModel.IncludePasswordsInSearch, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="SORT" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Title" />
                            <ComboBoxItem Content="Username" />
                            <ComboBoxItem Content="Website" />
                            <ComboBoxItem Content="Folder" />
                            <ComboBoxItem Content="Created" />
                            <ComboBoxItem Content="Last updated" />
                        </ComboBox>
                        <CheckBox Content="Descending" IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}" />
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <controls:HorizontalResizeGrid x:Name="NavigationPaneSplitter" Grid.Column="1" Background="Transparent"
                  PointerPressed="PaneSplitter_PointerPressed"
                  PointerMoved="PaneSplitter_PointerMoved"
                  PointerReleased="PaneSplitter_PointerReleased"
                  PointerCaptureLost="PaneSplitter_PointerCaptureLost"
                  ToolTipService.ToolTip="Drag to resize folders, filters, and sorting"
                  AutomationProperties.Name="Resize folders, filters, and sorting pane">
                <Border Width="2" Height="40" CornerRadius="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </controls:HorizontalResizeGrid>

            <Grid Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Margin="0,0,0,10" PlaceholderText="Search entries"
                                AutomationProperties.Name="Search vault entries"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <Grid Grid.Row="1" Margin="0,0,0,8" ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilterChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterChipItem">
                                <Button Content="{x:Bind Label}" Margin="0,0,6,4" Padding="8,3"
                                        Click="FilterChip_Click" AutomationProperties.Name="{x:Bind Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="1" Content="Clear filters" Padding="8,3" Click="ClearFilters_Click" />
                </Grid>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VaultEntryListItem">
                            <Grid Padding="8" ColumnSpacing="10">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copy username" Tag="{x:Bind Entry}"
                                                        Click="CopyEntryUsername_Click" />
                                        <MenuFlyoutItem Text="Copy password" Tag="{x:Bind Entry}"
                                                        Click="CopyEntryPassword_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Open website" Tag="{x:Bind Entry}"
                                                        Click="OpenEntryWebsite_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Username}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="{x:Bind FavoriteGlyph}" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:HorizontalResizeGrid x:Name="LoginListSplitter" Grid.Column="3" Background="Transparent"
                  PointerPressed="PaneSplitter_PointerPressed"
                  PointerMoved="PaneSplitter_PointerMoved"
                  PointerReleased="PaneSplitter_PointerReleased"
                  PointerCaptureLost="PaneSplitter_PointerCaptureLost"
                  ToolTipService.ToolTip="Drag to resize the login list"
                  AutomationProperties.Name="Resize login list pane">
                <Border Width="2" Height="40" CornerRadius="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </controls:HorizontalResizeGrid>

            <Grid Grid.Column="4" Padding="28">
                <TextBlock x:Name="NoSelectionText" Text="Select an entry or create a new login."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- Keep editor actions clear of WinUI's overlay scrollbar. -->
                    <StackPanel Margin="0,0,16,0" HorizontalAlignment="Stretch" Spacing="16">
                        <InfoBar Title="Read-only vault" Severity="Warning" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                 Message="Another Finalpass process is editing this file. You can view and copy entries, but changes are disabled." />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Header="Title" MaxLength="512" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                     Text="{Binding EntryTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleButton Grid.Column="1" Margin="0,22,0,0" Width="40"
                                          IsChecked="{Binding Favorite, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}"
                                          ToolTipService.ToolTip="Favorite" AutomationProperties.Name="Mark as favorite">
                                <FontIcon Glyph="&#xE735;" FontSize="14" />
                            </ToggleButton>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Header="Username" MaxLength="4096" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="0,22,0,0" Click="CopyUsername_Click"
                                    ToolTipService.ToolTip="Copy username (Ctrl+Shift+U)" AutomationProperties.Name="Copy username">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Header="Password" MaxLength="16384" Password="{Binding Password, Mode=TwoWay}" PasswordRevealMode="Peek"
                                         IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}" />
                            <Button Grid.Column="1" Margin="0,22,0,0" Click="GeneratePassword_Click"
                                    IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}" ToolTipService.ToolTip="Generate password or passphrase"
                                    AutomationProperties.Name="Generate password or passphrase">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Margin="0,22,0,0" Click="CopyPassword_Click"
                                    ToolTipService.ToolTip="Copy password (Ctrl+Shift+P)" AutomationProperties.Name="Copy password">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Header="Website" MaxLength="8192" IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                     Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="0,22,0,0" Click="OpenWebsite_Click"
                                    ToolTipService.ToolTip="Open website" AutomationProperties.Name="Open website in default browser">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ComboBox Header="Folder" HorizontalAlignment="Stretch"
                                  IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}"
                                  ItemsSource="{Binding FolderOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedFolderOption, Mode=TwoWay}" />
                        <TextBox Header="Tags" MaxLength="16384" PlaceholderText="work, email, finance"
                                 IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                 Text="{Binding TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Notes" MaxLength="1048576" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Custom fields" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Grid.Column="1" Content="Add field" Click="AddCustomField_Click"
                                        IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CustomFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CustomFieldItem">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox PlaceholderText="Name" MaxLength="256" IsReadOnly="{x:Bind IsReadOnly, Mode=OneWay}"
                                                     Text="{x:Bind Name, Mode=TwoWay}" />
                                            <TextBox Grid.Column="1" PlaceholderText="Value" MaxLength="65536"
                                                     IsReadOnly="{x:Bind IsReadOnly, Mode=OneWay}"
                                                     Text="{x:Bind Value, Mode=TwoWay}"
                                                     Visibility="{x:Bind NotSecret, Mode=OneWay}" />
                                            <PasswordBox Grid.Column="1" PlaceholderText="Value" MaxLength="65536" PasswordRevealMode="Peek"
                                                         IsEnabled="{x:Bind IsWritable, Mode=OneWay}"
                                                         Password="{x:Bind Value, Mode=TwoWay}"
                                                         Visibility="{x:Bind Secret, Mode=OneWay}" />
                                            <CheckBox Grid.Column="2" Content="Secret" IsChecked="{x:Bind Secret, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind IsWritable, Mode=OneWay}" />
                                            <Button Grid.Column="3" Click="RemoveCustomField_Click" ToolTipService.ToolTip="Remove field"
                                                    IsEnabled="{x:Bind IsWritable, Mode=OneWay}" AutomationProperties.Name="Remove custom field">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply changes" Style="{StaticResource AccentButtonStyle}" Click="ApplyEntry_Click"
                                    IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}" />
                            <Button Content="Delete entry" Click="DeleteEntry_Click"
                                    IsEnabled="{x:Bind ViewModel.IsWritable, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12,7" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" />
        </Border>
    </Grid>
</Page>
